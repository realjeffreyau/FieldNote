{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fieldnote.ai-compose-document.v1",
  "title": "FieldNote encounter digest composition response",
  "description": "Source-reference contract for a generic, clinician-reviewed encounter digest. It is not a PHI authorization contract and is not an official chart-note format.",
  "oneOf": [
    {
      "$ref": "#/$defs/success"
    },
    {
      "$ref": "#/$defs/error"
    }
  ],
  "$defs": {
    "sectionKey": {
      "type": "string",
      "enum": [
        "overview",
        "timeline",
        "patient_statements",
        "history",
        "observations",
        "tests",
        "interventions",
        "response",
        "disposition"
      ]
    },
    "blockKind": {
      "type": "string",
      "enum": ["paragraph", "bullets", "table", "quote"]
    },
    "sourceRef": {
      "type": "string",
      "pattern": "^s[0-9]{1,4}$"
    },
    "sourceRefs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/sourceRef"
      }
    },
    "bullet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "sourceRefs"],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "sourceRefs": {
          "$ref": "#/$defs/sourceRefs"
        }
      }
    },
    "tableRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cells", "sourceRefs"],
      "properties": {
        "cells": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "string",
            "maxLength": 500
          }
        },
        "sourceRefs": {
          "$ref": "#/$defs/sourceRefs"
        }
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "text", "items", "columns", "rows", "sourceRefs"],
      "properties": {
        "kind": {
          "$ref": "#/$defs/blockKind"
        },
        "text": {
          "type": "string",
          "maxLength": 1600
        },
        "items": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/bullet"
          }
        },
        "columns": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "maxLength": 120
          }
        },
        "rows": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/tableRow"
          }
        },
        "sourceRefs": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sourceRef"
          }
        }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "blocks"],
      "properties": {
        "key": {
          "$ref": "#/$defs/sectionKey"
        },
        "blocks": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/block"
          }
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question", "sourceRefs"],
      "properties": {
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "sourceRefs": {
          "$ref": "#/$defs/sourceRefs"
        }
      }
    },
    "requestId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "versionFields": {
      "type": "object",
      "required": ["contractVersion", "schemaVersion", "promptPolicyVersion", "sourceSpanPolicyVersion", "evaluationBundleVersion"],
      "properties": {
        "contractVersion": {
          "const": "fieldnote.ai-compose-document.v1"
        },
        "schemaVersion": {
          "const": "fieldnote.encounter-digest-schema.v1"
        },
        "promptPolicyVersion": {
          "const": "fieldnote.scribe-prompt-policy.v1"
        },
        "sourceSpanPolicyVersion": {
          "const": "fieldnote.scribe-source-span.v1"
        },
        "evaluationBundleVersion": {
          "const": "fieldnote.scribe-regression.v1"
        }
      }
    },
    "success": {
      "allOf": [
        {
          "$ref": "#/$defs/versionFields"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["contractVersion", "schemaVersion", "promptPolicyVersion", "sourceSpanPolicyVersion", "evaluationBundleVersion", "requestId", "generatedAt", "provider", "model", "validation", "document", "questions"],
          "properties": {
            "contractVersion": {
              "const": "fieldnote.ai-compose-document.v1"
            },
            "schemaVersion": {
              "const": "fieldnote.encounter-digest-schema.v1"
            },
            "promptPolicyVersion": {
              "const": "fieldnote.scribe-prompt-policy.v1"
            },
            "sourceSpanPolicyVersion": {
              "const": "fieldnote.scribe-source-span.v1"
            },
            "evaluationBundleVersion": {
              "const": "fieldnote.scribe-regression.v1"
            },
            "requestId": {
              "$ref": "#/$defs/requestId"
            },
            "generatedAt": {
              "type": "string",
              "format": "date-time"
            },
            "provider": {
              "type": "string",
              "minLength": 1
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "validation": {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "sourceRefsValid", "clinicianReviewRequired"],
              "properties": {
                "status": {
                  "const": "passed"
                },
                "sourceRefsValid": {
                  "const": true
                },
                "clinicianReviewRequired": {
                  "const": true
                }
              }
            },
            "document": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "title", "sections"],
              "properties": {
                "type": {
                  "const": "encounter_digest"
                },
                "title": {
                  "const": "Encounter digest"
                },
                "sections": {
                  "type": "array",
                  "maxItems": 9,
                  "items": {
                    "$ref": "#/$defs/section"
                  }
                }
              }
            },
            "questions": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "$ref": "#/$defs/question"
              }
            }
          }
        }
      ]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "requestId", "error"],
      "properties": {
        "contractVersion": {
          "const": "fieldnote.ai-compose-document.v1"
        },
        "requestId": {
          "$ref": "#/$defs/requestId"
        },
        "error": {
          "type": "string",
          "enum": [
            "invalid_json",
            "request_too_large",
            "document_type_required",
            "review_required",
            "segments_required",
            "segment_invalid",
            "segment_text_required",
            "transcript_too_long",
            "possible_identifier_detected",
            "model_invalid_output",
            "model_source_mismatch",
            "ollama_unavailable",
            "ollama_request_failed",
            "rate_limit_exceeded",
            "server_error"
          ]
        },
        "retryAfter": {
          "type": "integer",
          "minimum": 0
        },
        "maxCharacters": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
